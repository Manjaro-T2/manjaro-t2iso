[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = wpa_supplicant

[Action]
Description = Blocking wpa_supplicant upgrades
When = PreTransaction
Exec = /bin/sh -c 'printf "\033[1;31m\nERROR: Upgrading wpa_supplicant is disabled on this system.\nT2 Linux requires a pinned version for T2 Mac WiFi in order to make the firmware function correctly.\n\033[0m"; exit 1'

